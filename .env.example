# ========================================================
# Free UPI Payment Gateway - Environment Configuration
# ========================================================

# 1. BharatPe Merchant Credentials
# Extract these from enterprise.bharatpe.in (Network Tab) or BharatPe App
BHARATPE_MERCHANT_ID=your_merchant_id_here
BHARATPE_TOKEN=your_token_here
BHARATPE_UPI_VPA=your_vpa@unitype
MERCHANT_DISPLAY_NAME=FreeUPI Gateway

# 2. Decimal Offset Matching (True = 100% collision-free auto verification)
ENABLE_DECIMAL_MATCH=true

# 3. Session Timeout in Seconds (600s = 10 minutes)
INTENT_EXPIRY_SECONDS=600

# 4. Background Reconciler Polling Interval (in seconds)
RECONCILER_INTERVAL_SECONDS=5

# 5. Optional Webhook (Called automatically when payment succeeds)
# WEBHOOK_URL=https://yourdomain.com/api/payment/webhook
# WEBHOOK_SECRET=your_secret_signing_key_here

# 6. Server Host and Port
HOST=0.0.0.0
PORT=8000
DEBUG=false
